<header class="ccs-pop-header">
  <img class="ccs-pop-banner{{#if card.imgIsIcon}} is-icon{{/if}}" src="{{card.img}}" alt="">
  <span class="ccs-cap ccs-cap-top frame-{{card.frameKey}}" aria-hidden="true"></span>
  <h3>{{card.name}}</h3>
  <span class="ccs-pop-type"><i class="{{card.typeIcon}}" aria-hidden="true"></i> {{card.typeLabel}}</span>
  {{#if facts.length}}
    <ul class="ccs-pop-facts">
      {{#each facts}}<li>{{this}}</li>{{/each}}
    </ul>
  {{/if}}
</header>
{{#if resource}}
  <div class="ccs-pop-resource">
    <span class="ccs-pop-resource-label">{{resource.label}}{{#if resource.source}} <em>· {{resource.source}}</em>{{/if}}</span>
    {{#if editable}}
      <button type="button" class="ccs-pop-control" data-popover-action="resourceDown"
              data-tooltip="{{localize 'CCS.Resource.Spend'}}" aria-label="{{localize 'CCS.Resource.Spend'}}: {{resource.label}}">
        <i class="fa-solid fa-minus" aria-hidden="true"></i>
      </button>
    {{/if}}
    <span class="ccs-pop-resource-value">{{resource.value}} / {{resource.max}}</span>
    {{#if editable}}
      <button type="button" class="ccs-pop-control" data-popover-action="resourceUp"
              data-tooltip="{{localize 'CCS.Resource.Refill'}}" aria-label="{{localize 'CCS.Resource.Refill'}}: {{resource.label}}">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
      </button>
    {{/if}}
  </div>
{{/if}}
{{#if sockets}}
  <section class="ccs-pop-sockets" aria-label="{{localize 'CCS.Socket.Title'}}">
    <div class="ccs-pop-sockets-head">
      <span class="ccs-pop-resource-label">{{localize 'CCS.Socket.Title'}}{{#if sockets.source}} <em>· {{sockets.source}}</em>{{/if}}</span>
      {{#if (and editable sockets.anySpent)}}
        <button type="button" class="ccs-pop-control" data-popover-action="refreshSockets"
                data-tooltip="{{localize 'CCS.Socket.Refresh'}}" aria-label="{{localize 'CCS.Socket.Refresh'}}">
          <i class="fa-solid fa-rotate" aria-hidden="true"></i>
        </button>
      {{/if}}
    </div>
    {{#each sockets.slots}}
      {{#if id}}
        <div class="ccs-pop-socket{{#if spent}} is-spent{{/if}}">
          <span class="ccs-pop-socket-ring is-filled"><img class="{{#if imgIsIcon}}is-icon{{/if}}" src="{{img}}" alt=""></span>
          <span class="ccs-pop-socket-name">{{name}}{{#if spent}} <em>· {{localize 'CCS.Socket.Spent'}}</em>{{/if}}</span>
          {{#if @root.editable}}
            <button type="button" class="ccs-pop-control" data-popover-action="useSocketed" data-cypher-id="{{id}}"
                    data-tooltip="{{#if reusable}}{{localize 'CCS.Socket.UseReusable'}}{{else}}{{localize 'CCS.Socket.Use'}}{{/if}}"
                    aria-label="{{localize 'CCS.Socket.Use'}}: {{name}}" {{#if spent}}disabled{{/if}}>
              <i class="fa-solid fa-bolt" aria-hidden="true"></i>
            </button>
            <button type="button" class="ccs-pop-control" data-popover-action="unsocketCypher" data-cypher-id="{{id}}"
                    data-tooltip="{{localize 'CCS.Socket.Unsocket'}}" aria-label="{{localize 'CCS.Socket.Unsocket'}}: {{name}}">
              <i class="fa-solid fa-eject" aria-hidden="true"></i>
            </button>
          {{/if}}
        </div>
      {{else}}
        <button type="button" class="ccs-pop-socket is-empty" data-popover-action="socketPick" data-slot="{{index}}"
                {{#unless @root.editable}}disabled{{/unless}}>
          <span class="ccs-pop-socket-ring"></span>
          <span class="ccs-pop-socket-name">{{localize 'CCS.Socket.Choose'}}</span>
        </button>
      {{/if}}
    {{/each}}
  </section>
{{/if}}
<div class="ccs-pop-desc">{{{description}}}</div>
{{!-- One row, stacked right to left: archive in the corner, then the item's controls. --}}
<footer class="ccs-pop-bar">
  <span class="ccs-cap ccs-cap-bottom frame-{{card.frameKey}}" aria-hidden="true"></span>
  {{#if editable}}
    <button type="button" class="ccs-pop-archive" data-popover-action="archiveItem"
            data-tooltip="{{#if card.archived}}{{localize 'CCS.Action.UnarchiveAltDelete'}}{{else}}{{localize 'CCS.Action.ArchiveAltDelete'}}{{/if}}"
            aria-label="{{#if card.archived}}{{localize 'CCS.Action.Unarchive'}}{{else}}{{localize 'CCS.Action.Archive'}}{{/if}}">
      <i class="fa-solid {{#if card.archived}}fa-box-open{{else}}fa-box-archive{{/if}}" aria-hidden="true"></i>
    </button>
  {{/if}}
  {{#each controls}}
    <button type="button" class="ccs-pop-control{{#if pressed}} is-on{{/if}}" data-popover-action="{{action}}"
            data-tooltip="{{label}}{{#if (ne title label)}}: {{title}}{{/if}}" aria-label="{{label}}"{{#if pressed}} aria-pressed="true"{{/if}}>
      <i class="{{icon}}"{{#if color}} style="color: {{color}};"{{/if}} aria-hidden="true"></i>
    </button>
  {{/each}}
</footer>
