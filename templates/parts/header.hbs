<div class="ccs-top{{#if layout.portraitTall}} is-tall{{/if}}">
  <div class="ccs-portrait-wrap">
    <img class="ccs-portrait" src="{{identity.img}}" alt="{{identity.name}}"
         {{#if editable}}data-action="editImage" data-path="{{identity.imgPath}}" role="button" tabindex="0" title="{{localize 'CCS.Header.EditImage'}}"{{/if}}>
    <div class="ccs-portrait-badges">
      {{#if state.exclusiveTag}}
        <span class="ccs-badge" title="{{localize 'CYPHERSYSTEM.ExclusiveTag'}}: {{state.exclusiveTag}}"><i class="fa-solid fa-hashtag"></i></span>
      {{/if}}
      {{#if state.staticStatsLocked}}
        <span class="ccs-badge" title="{{localize 'CCS.Header.StatsLocked'}}"><i class="fa-solid fa-lock"></i></span>
      {{/if}}
      {{#if state.multiRoll}}
        <button type="button" class="ccs-badge ccs-badge-action" data-action="endMultiRoll" title="{{localize 'CYPHERSYSTEM.MultiRollInProgress'}}"
                {{#unless editable}}disabled{{/unless}}><i class="fa-solid fa-dice"></i></button>
      {{/if}}
    </div>
  </div>

<header class="ccs-header">
  <div class="ccs-identity">
    <div class="ccs-row">
      <input class="ccs-name" type="text" name="{{identity.namePath}}" value="{{identity.name}}"
             placeholder="{{localize 'CYPHERSYSTEM.Name'}}" aria-label="{{localize 'CYPHERSYSTEM.Name'}}">
      {{#if identity.showFormSelect}}
        <select name="system.basic.unmaskedForm" aria-label="{{localize 'CCS.Header.Form'}}">
          {{selectOptions settings.choices.unmaskedForm selected=system.basic.unmaskedForm}}
        </select>
      {{/if}}
    </div>
    <div class="ccs-sentence">
      <span class="ccs-joiner">{{identity.isLabel}}</span>
      <input type="text" name="{{identity.descriptorPath}}" value="{{identity.descriptor}}"
             placeholder="{{localize 'CYPHERSYSTEM.Descriptor'}}" aria-label="{{localize 'CYPHERSYSTEM.Descriptor'}}">
      {{#unless identity.teen}}
        <input type="text" name="system.basic.type" value="{{identity.type}}"
               placeholder="{{localize 'CYPHERSYSTEM.Type'}}" aria-label="{{localize 'CYPHERSYSTEM.Type'}}">
        <span class="ccs-joiner">{{localize 'CYPHERSYSTEM.Who'}}</span>
        <input type="text" name="system.basic.focus" value="{{identity.focus}}" {{#if identity.focusLocked}}disabled{{/if}}
               placeholder="{{localize 'CYPHERSYSTEM.Focus'}}" aria-label="{{localize 'CYPHERSYSTEM.Focus'}}">
        {{#if identity.showSentence}}
          <input type="text" name="system.basic.additionalSentence" value="{{identity.sentence}}" {{#if identity.focusLocked}}disabled{{/if}}
                 placeholder="{{identity.sentencePlaceholder}}" aria-label="{{identity.sentencePlaceholder}}">
        {{/if}}
      {{/unless}}
    </div>
    <div class="ccs-advancement">
      <span class="ccs-label">{{localize 'CCS.Header.Advancement'}}</span>
      {{#each identity.advancement}}
        <label class="ccs-check">
          <input type="checkbox" name="{{path}}" {{checked checked}} {{#if @root.locked}}disabled{{/if}}> {{label}}
        </label>
      {{/each}}
      <button type="button" class="ccs-icon-btn" data-action="resetAdvancement" title="{{localize 'CYPHERSYSTEM.ResetAdvancement'}}"
              aria-label="{{localize 'CYPHERSYSTEM.ResetAdvancement'}}" {{#unless editable}}disabled{{/unless}}>
        <i class="fa-solid fa-rotate"></i>
      </button>
    </div>
  </div>

  <div class="ccs-vitals">
    <label class="ccs-vital-label" for="{{actor.id}}-tier">{{localize 'CYPHERSYSTEM.Tier'}}</label>
    <input class="ccs-vital-input" id="{{actor.id}}-tier" type="number" name="system.basic.tier" value="{{identity.tier}}" {{#if locked}}disabled{{/if}}>

    <label class="ccs-vital-label" for="{{actor.id}}-effort">{{localize 'CYPHERSYSTEM.Effort'}}</label>
    <input class="ccs-vital-input{{#if state.multiRollEffort}} is-changed{{/if}}" id="{{actor.id}}-effort" type="number"
           name="system.basic.effort" value="{{identity.effort}}" {{#if locked}}disabled{{/if}}>

    <label class="ccs-vital-label" for="{{actor.id}}-xp">{{localize 'CYPHERSYSTEM.XP'}}</label>
    <button type="button" class="ccs-icon-btn ccs-vital-down" data-action="xpAdjust" data-dir="-1" aria-label="{{localize 'CCS.Header.XpDown'}}"
            title="{{localize 'CCS.Action.AltTen'}}" {{#unless editable}}disabled{{/unless}}><i class="fa-solid fa-minus"></i></button>
    <input class="ccs-vital-input" id="{{actor.id}}-xp" type="number" name="system.basic.xp" value="{{identity.xp}}">
    <button type="button" class="ccs-icon-btn ccs-vital-up" data-action="xpAdjust" data-dir="1" aria-label="{{localize 'CCS.Header.XpUp'}}"
            title="{{localize 'CCS.Action.AltTen'}}" {{#unless editable}}disabled{{/unless}}><i class="fa-solid fa-plus"></i></button>
  </div>
</header>
  <div class="ccs-pools">
    {{#each pools}}
      <div class="ccs-pool pool-{{key}}">
        <div class="ccs-pool-head">
          <span class="ccs-pool-label">{{label}}</span>
          {{#if rollable}}
            <button type="button" class="ccs-icon-btn ccs-pool-roll" data-action="statRoll" data-pool="{{key}}"
                    title="{{localize 'CCS.Pool.Roll' pool=label}}" aria-label="{{localize 'CCS.Pool.Roll' pool=label}}"
                    {{#unless @root.editable}}disabled{{/unless}}>
              <i class="fa-solid fa-dice-d20"></i>
            </button>
          {{/if}}
        </div>
        <div class="ccs-pool-values">
          <input class="ccs-pool-value" type="number" name="{{valuePath}}" value="{{value}}" aria-label="{{label}}">
          <span class="ccs-pool-sep" aria-hidden="true">{{@root.poolSeparator}}</span>
          <input class="ccs-pool-max" type="number" name="{{maxPath}}" value="{{max}}" aria-label="{{localize 'CCS.Pool.Max' pool=label}}"
                 {{#if @root.locked}}disabled{{/if}}>
        </div>
        <div class="ccs-pool-foot">
          <div class="ccs-pool-controls">
            <button type="button" class="ccs-icon-btn" data-action="poolAdjust" data-pool="{{key}}" data-dir="-1"
                    title="{{localize 'CCS.Action.AltTen'}}" aria-label="{{localize 'CCS.Pool.Down' pool=label}}" {{#unless @root.editable}}disabled{{/unless}}>
              <i class="fa-solid fa-minus"></i>
            </button>
            <button type="button" class="ccs-icon-btn" data-action="poolAdjust" data-pool="{{key}}" data-dir="1"
                    title="{{localize 'CCS.Action.AltTen'}}" aria-label="{{localize 'CCS.Pool.Up' pool=label}}" {{#unless @root.editable}}disabled{{/unless}}>
              <i class="fa-solid fa-plus"></i>
            </button>
            <button type="button" class="ccs-icon-btn" data-action="poolReset" data-pool="{{key}}"
                    title="{{localize 'CCS.Pool.Reset' pool=label}}" aria-label="{{localize 'CCS.Pool.Reset' pool=label}}" {{#unless @root.editable}}disabled{{/unless}}>
              <i class="fa-solid fa-rotate"></i>
            </button>
          </div>
          {{#if hasEdge}}
            <label class="ccs-edge">
              <span>{{localize 'CYPHERSYSTEM.Edge'}}</span>
              <input type="number" name="{{edgePath}}" value="{{edge}}" class="{{#if edgeChanged}}is-changed{{/if}}"
                     {{#if @root.locked}}disabled{{/if}}>
            </label>
          {{/if}}
        </div>
      </div>
    {{/each}}
    {{#if logo}}
      <div class="ccs-pool ccs-logo-slot" aria-hidden="true">
        <img class="logo-{{logo.variant}}" src="{{logo.src}}" style="opacity: {{logo.opacity}};" alt="">
      </div>
    {{/if}}
  </div>
</div>
