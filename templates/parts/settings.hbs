{{#*inline "ccsCheck"}}
  <label class="ccs-check{{#if disabled}} is-disabled{{/if}}" {{#if tooltip}}data-tooltip="{{tooltip}}"{{/if}}><input type="checkbox" name="{{name}}" {{checked value}} {{#if disabled}}disabled{{/if}}> {{label}}</label>
{{/inline}}
{{#*inline "ccsText"}}
  <label class="ccs-field"><span>{{label}}</span><input type="text" name="{{name}}" value="{{value}}" placeholder="{{placeholder}}"></label>
{{/inline}}
{{#*inline "ccsSelect"}}
  <label class="ccs-field"><span>{{label}}</span>
    <select name="{{name}}" {{#if number}}data-dtype="Number"{{/if}}>{{selectOptions choices selected=value}}</select>
  </label>
{{/inline}}
{{#*inline "ccsRange"}}
  <label class="ccs-field"><span>{{label}}</span>
    <input type="range" name="{{name}}" value="{{value}}" min="0" max="1" step="0.05" data-dtype="Number">
  </label>
{{/inline}}
{{#*inline "ccsPath"}}
  <div class="ccs-field ccs-path">
    <span>{{label}}</span>
    <input type="text" name="{{name}}" value="{{value}}" placeholder="{{placeholder}}" aria-label="{{label}}">
    <button type="button" class="ccs-icon-btn" data-action="pickFile" data-target="{{name}}" title="{{localize 'CCS.Settings.Browse'}}"
            aria-label="{{localize 'CCS.Settings.Browse'}}"><i class="fa-solid fa-file-import"></i></button>
  </div>
{{/inline}}
{{#*inline "ccsDesign"}}
  <section class="ccs-fieldset">
    <h4 class="ccs-fieldset-title">{{localize 'CCS.Settings.SheetDesign'}}</h4>
    {{#unless @root.settings.cyphersheetsActive}}
      {{> ccsSelect name=(concat base ".background.image") value=data.background.image choices=@root.settings.choices.backgroundImage label=(localize "CYPHERSYSTEM.BackgroundImage")}}
      {{#if (eq data.background.image "custom")}}
        {{> ccsPath name=(concat base ".background.imagePath") value=data.background.imagePath label=(localize "CCS.Settings.ImagePath")}}
        {{> ccsRange name=(concat base ".background.overlayOpacity") value=data.background.overlayOpacity label=(localize "CYPHERSYSTEM.BGImageOverlayOpacity")}}
      {{/if}}
    {{/unless}}
    {{#unless data.additionalPool.active}}
      {{> ccsSelect name=(concat base ".logo.image") value=data.logo.image choices=@root.settings.choices.logoImage label=(localize "CYPHERSYSTEM.CypherLogo")}}
      {{#if (eq data.logo.image "custom")}}
        {{> ccsPath name=(concat base ".logo.imagePath") value=data.logo.imagePath label=(localize "CCS.Settings.ImagePath")}}
        {{> ccsRange name=(concat base ".logo.imageOpacity") value=data.logo.imageOpacity label=(localize "CYPHERSYSTEM.CSLogoOpacity")}}
      {{/if}}
    {{/unless}}
  </section>
{{/inline}}

{{#with system.settings as |s|}}
<div class="ccs-settings">

  {{!-- General --}}
  <section class="ccs-fieldset">
    <h4 class="ccs-fieldset-title">{{localize 'CCS.Settings.General'}}</h4>
    {{#if @root.identity.teen}}
      {{> ccsCheck name="system.teen.settings.general.rollTwoD20" value=@root.settings.teenGeneral.rollTwoD20 label=(localize "CYPHERSYSTEM.RollTwoD20")}}
      {{> ccsCheck name="system.teen.settings.general.additionalPool.active" value=@root.settings.teenGeneral.additionalPool.active label=(localize "CYPHERSYSTEM.AdditionalPoolSetting")
          disabled=@root.settings.compact.active tooltip=(ifThen @root.settings.compact.active (localize "CCS.Settings.CompactBlocksPool") "")}}
      {{> ccsText name="system.teen.settings.general.additionalPool.name" value=@root.settings.teenGeneral.additionalPool.name label=(localize "CCS.Settings.Label") placeholder=(localize "CYPHERSYSTEM.AdditionalPool")}}
    {{else}}
      {{> ccsSelect name="system.settings.general.gameMode" value=s.general.gameMode choices=@root.settings.choices.gameMode label=(localize "CYPHERSYSTEM.GameMode")}}
      {{> ccsCheck name="system.settings.general.additionalSentence.active" value=s.general.additionalSentence.active label=(localize "CYPHERSYSTEM.AdditionalSentenceField")}}
      {{> ccsText name="system.settings.general.additionalSentence.label" value=s.general.additionalSentence.label label=(localize "CCS.Settings.Label") placeholder=(localize "CYPHERSYSTEM.AdditionalSentence")}}
      {{> ccsCheck name="system.settings.general.rollTwoD20" value=s.general.rollTwoD20 label=(localize "CYPHERSYSTEM.RollTwoD20")}}
      {{> ccsCheck name="system.settings.general.additionalPool.active" value=s.general.additionalPool.active label=(localize "CYPHERSYSTEM.AdditionalPoolSetting")
          disabled=@root.settings.compact.active tooltip=(ifThen @root.settings.compact.active (localize "CCS.Settings.CompactBlocksPool") "")}}
      {{> ccsText name="system.settings.general.additionalPool.label" value=s.general.additionalPool.label label=(localize "CCS.Settings.Label") placeholder=(localize "CYPHERSYSTEM.AdditionalPool")}}
      {{#if s.general.additionalPool.active}}
        {{> ccsCheck name="system.settings.general.additionalPool.hasEdge" value=s.general.additionalPool.hasEdge label=(localize "CYPHERSYSTEM.AdditionalPoolHasEdge")}}
      {{/if}}
    {{/if}}
    {{> ccsSelect name="system.settings.general.showPrice" value=s.general.showPrice choices=@root.settings.choices.showPrice label=(localize "CYPHERSYSTEM.ShowPrice")}}
    {{> ccsCheck name="system.settings.general.hideEmptyCategories" value=s.general.hideEmptyCategories label=(localize "CYPHERSYSTEM.HideEmptyCategories")}}
    {{> ccsCheck name="system.settings.general.hideFavoriteButton" value=s.general.hideFavoriteButton label=(localize "CYPHERSYSTEM.HideFavoriteButton")}}
    {{#if @root.identity.teen}}
      {{> ccsCheck name="system.teen.settings.general.customSheetDesign" value=@root.settings.teenGeneral.customSheetDesign label=(localize "CYPHERSYSTEM.CustomSheetDesign")}}
    {{else}}
      {{> ccsCheck name="system.settings.general.customSheetDesign" value=s.general.customSheetDesign label=(localize "CYPHERSYSTEM.CustomSheetDesign")}}
    {{/if}}
  </section>

  {{!-- Sheet layout (module flags) --}}
  <section class="ccs-fieldset">
    <h4 class="ccs-fieldset-title">{{localize 'CCS.Settings.Layout'}}</h4>
    {{> ccsText name=@root.settings.cardsTab.path value=@root.settings.cardsTab.value label=(localize "CCS.Settings.CardsTabName")
        placeholder=@root.settings.cardsTab.placeholder}}
    {{> ccsCheck name=@root.settings.compact.path value=@root.settings.compact.value label=(localize "CCS.Settings.Compact")
        disabled=(and @root.settings.compact.blocked (not @root.settings.compact.value))
        tooltip=(ifThen @root.settings.compact.blocked (localize "CCS.Settings.PoolBlocksCompact") "")}}
    <p class="ccs-hint">{{#if @root.settings.compact.blocked}}{{localize "CCS.Settings.PoolBlocksCompact"}}{{else}}{{localize "CCS.Settings.CompactHint"}}{{/if}}</p>
    {{> ccsCheck name=@root.settings.portraitTall.path value=@root.settings.portraitTall.value label=(localize "CCS.Settings.PortraitTall")}}
    {{> ccsCheck name=@root.settings.highContrast.path value=@root.settings.highContrast.value label=(localize "CCS.Settings.HighContrastFrames")}}
    <p class="ccs-hint">{{localize "CCS.Settings.HighContrastFramesHint"}}</p>
    {{> ccsPath name=@root.settings.armorImage.path value=@root.settings.armorImage.value
        placeholder=@root.settings.armorImage.placeholder label=(localize "CCS.Settings.ArmorImage")}}
  </section>

  {{!-- Badge: the lower-right image (the system's own background icon fields) --}}
  <section class="ccs-fieldset">
    <h4 class="ccs-fieldset-title">{{localize 'CCS.Settings.Badge'}}</h4>
    {{#with @root.settings.badge as |b|}}
      {{> ccsSelect name=(concat b.base ".icon") value=b.icon choices=@root.settings.choices.backgroundIcon label=(localize "CCS.Settings.BadgeImage")}}
      {{#if (eq b.icon "custom")}}
        {{> ccsPath name=(concat b.base ".iconPath") value=b.iconPath label=(localize "CCS.Settings.ImagePath")}}
      {{/if}}
      {{> ccsRange name=(concat b.base ".iconOpacity") value=b.opacity label=(localize "CCS.Settings.BadgeOpacity")}}
    {{/with}}
  </section>

  {{!-- Pool names (module flags; also shown in roll dialogs and chat) --}}
  <section class="ccs-fieldset">
    <h4 class="ccs-fieldset-title">{{localize 'CCS.Settings.PoolNames'}}</h4>
    <p class="ccs-hint">{{localize 'CCS.Settings.PoolNamesHint'}}</p>
    {{#each @root.settings.poolNames}}
      {{> ccsText name=path value=value label=placeholder placeholder=placeholder}}
    {{/each}}
  </section>

  {{!-- Movement ranges (module flags; used by the token ruler) --}}
  <section class="ccs-fieldset">
    <h4 class="ccs-fieldset-title">{{localize 'CCS.Settings.Movement'}}</h4>
    <p class="ccs-hint">{{localize 'CCS.Settings.MovementHint'}}</p>
    {{#each @root.settings.movement}}
      <label class="ccs-field"><span>{{label}}</span>
        <input type="number" name="{{path}}" value="{{value}}" min="0" step="any" placeholder="{{placeholder}}">
      </label>
    {{/each}}
  </section>

  {{!-- Sheet design --}}
  {{#if @root.identity.teen}}
    {{#if @root.settings.teenGeneral.customSheetDesign}}{{> ccsDesign base="system.teen.settings.general" data=@root.settings.teenGeneral}}{{/if}}
  {{else}}
    {{#if s.general.customSheetDesign}}{{> ccsDesign base="system.settings.general" data=s.general}}{{/if}}
  {{/if}}

  {{!-- Tags --}}
  {{#unless @root.identity.teen}}
    <section class="ccs-fieldset">
      <h4 class="ccs-fieldset-title">{{localize 'CYPHERSYSTEM.Tags'}}</h4>
      {{> ccsCheck name="system.settings.general.tags.active" value=s.general.tags.active
          label=(localize (ifThen (eq s.general.gameMode "Strange") "CYPHERSYSTEM.ShowTagsInRecursionTab" "CYPHERSYSTEM.ShowTagsTab"))}}
      {{#if s.general.tags.active}}
        <span class="ccs-label">{{localize 'CYPHERSYSTEM.TagCategories'}}</span>
        <p class="ccs-hint">{{localize 'CCS.Settings.TagCategoriesHint'}}</p>
        {{> ccsText name="system.settings.general.tags.labelCategory1" value=s.general.tags.labelCategory1 label="1" placeholder=(localize "CYPHERSYSTEM.Tags")}}
        {{> ccsText name="system.settings.general.tags.labelCategory2" value=s.general.tags.labelCategory2 label="2" placeholder=(localize "CYPHERSYSTEM.TagCategoryTwo")}}
        {{> ccsText name="system.settings.general.tags.labelCategory3" value=s.general.tags.labelCategory3 label="3" placeholder=(localize "CYPHERSYSTEM.TagCategoryThree")}}
        {{> ccsText name="system.settings.general.tags.labelCategory4" value=s.general.tags.labelCategory4 label="4" placeholder=(localize "CYPHERSYSTEM.TagCategoryFour")}}
      {{/if}}
    </section>
  {{/unless}}

  {{!-- Skills --}}
  <section class="ccs-fieldset">
    <h4 class="ccs-fieldset-title">{{localize 'CYPHERSYSTEM.Skills'}}</h4>
    {{#unless @root.identity.teen}}
      <span class="ccs-label">{{localize 'CYPHERSYSTEM.SkillCategories'}}</span>
      {{> ccsText name="system.settings.skills.labelCategory1" value=s.skills.labelCategory1 label="1" placeholder=(localize "CYPHERSYSTEM.Skills")}}
      {{> ccsText name="system.settings.skills.labelCategory2" value=s.skills.labelCategory2 label="2" placeholder=(localize "CYPHERSYSTEM.SkillCategoryTwo")}}
      {{> ccsText name="system.settings.skills.labelCategory3" value=s.skills.labelCategory3 label="3" placeholder=(localize "CYPHERSYSTEM.SkillCategoryThree")}}
      {{> ccsText name="system.settings.skills.labelCategory4" value=s.skills.labelCategory4 label="4" placeholder=(localize "CYPHERSYSTEM.SkillCategoryFour")}}
    {{/unless}}
    {{> ccsCheck name="system.settings.skills.sortByRating" value=s.skills.sortByRating label=(localize "CYPHERSYSTEM.SortSkillsByRating")}}
    {{#unless @root.identity.teen}}
      {{> ccsCheck name="system.settings.skills.powerShifts.active" value=s.skills.powerShifts.active label=(localize "CYPHERSYSTEM.PowerShifts")}}
      {{> ccsText name="system.settings.skills.powerShifts.label" value=s.skills.powerShifts.label label=(localize "CCS.Settings.Label") placeholder=(localize "CYPHERSYSTEM.PowerShifts")}}
    {{/unless}}
  </section>

  {{!-- Combat and recovery --}}
  <section class="ccs-fieldset">
    <h4 class="ccs-fieldset-title">{{localize 'CCS.Settings.Combat'}}</h4>
    {{#unless @root.identity.teen}}
      {{> ccsCheck name="system.settings.combat.stress.active" value=s.combat.stress.active label=(localize "CYPHERSYSTEM.Stress")}}
      {{> ccsText name="system.settings.combat.stress.label" value=s.combat.stress.label label=(localize "CCS.Settings.Label") placeholder=(localize "CYPHERSYSTEM.Stress")}}
      {{#if s.combat.stress.active}}
        {{> ccsCheck name="system.settings.combat.stress.supernaturalStressActive" value=s.combat.stress.supernaturalStressActive label=(localize "CYPHERSYSTEM.SupernaturalStressLabel")}}
        {{> ccsText name="system.settings.combat.stress.supernaturalStressLabel" value=s.combat.stress.supernaturalStressLabel label=(localize "CCS.Settings.Label") placeholder=(localize "CYPHERSYSTEM.SupernaturalStress")}}
      {{/if}}
      {{> ccsCheck name="system.settings.combat.additionalStepDamageTrack.active" value=s.combat.additionalStepDamageTrack.active label=(localize "CYPHERSYSTEM.AdditionalStepDamageTrackSetting")}}
      {{> ccsText name="system.settings.combat.additionalStepDamageTrack.label" value=s.combat.additionalStepDamageTrack.label label=(localize "CCS.Settings.Label") placeholder=(localize "CYPHERSYSTEM.Hurt")}}
      {{> ccsSelect name="system.settings.combat.numberOneActionRecoveries" value=s.combat.numberOneActionRecoveries number=true choices=@root.settings.choices.oneActionRecoveries label=(localize "CYPHERSYSTEM.AdditionalRecoveryRolls")}}
      {{> ccsSelect name="system.settings.combat.numberTenMinuteRecoveries" value=s.combat.numberTenMinuteRecoveries number=true choices=@root.settings.choices.tenMinuteRecoveries label=(localize "CYPHERSYSTEM.NumberOfTenMinuteRecoveryRolls")}}
    {{/unless}}
    {{> ccsCheck name="system.settings.combat.lastingDamage.active" value=s.combat.lastingDamage.active label=(localize "CYPHERSYSTEM.LastingAndPermanentDamageSetting")}}
    {{> ccsCheck name="system.settings.combat.ammo.active" value=s.combat.ammo.active label=(localize "CYPHERSYSTEM.AmmoList")}}
    {{> ccsCheck name="system.settings.combat.armor.active" value=s.combat.armor.active label=(localize "CYPHERSYSTEM.ArmorList")}}
  </section>

  <section class="ccs-fieldset">
    <h4 class="ccs-fieldset-title">{{localize 'CCS.Settings.RecoveryLabels'}}</h4>
    <p class="ccs-hint">{{localize 'CCS.Settings.RecoveryLabelsHint'}}</p>
    {{#each @root.settings.recoveryLabels}}
      {{> ccsText name=path value=value label=placeholder placeholder=placeholder}}
    {{/each}}
  </section>

  {{!-- Abilities --}}
  {{#unless @root.identity.teen}}
    <section class="ccs-fieldset">
      <h4 class="ccs-fieldset-title">{{localize 'CYPHERSYSTEM.Abilities'}}</h4>
      <span class="ccs-label">{{localize 'CYPHERSYSTEM.AbilityCategories'}}</span>
      {{> ccsText name="system.settings.abilities.labelCategory1" value=s.abilities.labelCategory1 label="1" placeholder=(localize "CYPHERSYSTEM.Abilities")}}
      {{> ccsText name="system.settings.abilities.labelCategory2" value=s.abilities.labelCategory2 label="2" placeholder=(localize "CYPHERSYSTEM.AbilityCategoryTwo")}}
      {{> ccsText name="system.settings.abilities.labelCategory3" value=s.abilities.labelCategory3 label="3" placeholder=(localize "CYPHERSYSTEM.AbilityCategoryThree")}}
      {{> ccsText name="system.settings.abilities.labelCategory4" value=s.abilities.labelCategory4 label="4" placeholder=(localize "CYPHERSYSTEM.AbilityCategoryFour")}}
      {{> ccsText name="system.settings.abilities.labelSpells" value=s.abilities.labelSpells label=(localize "CYPHERSYSTEM.Spells") placeholder=(localize "CYPHERSYSTEM.Spells")}}
    </section>
  {{/unless}}

  {{!-- Equipment --}}
  <section class="ccs-fieldset">
    <h4 class="ccs-fieldset-title">{{localize 'CYPHERSYSTEM.Equipment'}}</h4>
    <span class="ccs-label">{{localize 'CYPHERSYSTEM.EquipmentCategories'}}</span>
    {{> ccsText name="system.settings.equipment.labelCategory1" value=s.equipment.labelCategory1 label="1" placeholder=(localize "CYPHERSYSTEM.Equipment")}}
    {{> ccsText name="system.settings.equipment.labelCategory2" value=s.equipment.labelCategory2 label="2" placeholder=(localize "CYPHERSYSTEM.EquipmentCategoryTwo")}}
    {{> ccsText name="system.settings.equipment.labelCategory3" value=s.equipment.labelCategory3 label="3" placeholder=(localize "CYPHERSYSTEM.EquipmentCategoryThree")}}
    {{> ccsText name="system.settings.equipment.labelCategory4" value=s.equipment.labelCategory4 label="4" placeholder=(localize "CYPHERSYSTEM.EquipmentCategoryFour")}}

    {{> ccsCheck name="system.settings.equipment.currency.active" value=s.equipment.currency.active label=(localize "CYPHERSYSTEM.Currency")}}
    {{#if s.equipment.currency.active}}
      {{> ccsSelect name="system.settings.equipment.currency.numberCategories" value=s.equipment.currency.numberCategories number=true choices=@root.settings.choices.currency label=(localize "CCS.Settings.CurrencyCount")}}
      {{> ccsCheck name="system.settings.equipment.currency.hideLabels" value=s.equipment.currency.hideLabels label=(localize "CYPHERSYSTEM.HideCurrency")}}
      {{> ccsText name="system.settings.equipment.currency.labelCategory1" value=s.equipment.currency.labelCategory1 label="1" placeholder=(localize "CYPHERSYSTEM.Currency")}}
      {{> ccsText name="system.settings.equipment.currency.labelCategory2" value=s.equipment.currency.labelCategory2 label="2" placeholder=(localize "CYPHERSYSTEM.Currency")}}
      {{> ccsText name="system.settings.equipment.currency.labelCategory3" value=s.equipment.currency.labelCategory3 label="3" placeholder=(localize "CYPHERSYSTEM.Currency")}}
      {{> ccsText name="system.settings.equipment.currency.labelCategory4" value=s.equipment.currency.labelCategory4 label="4" placeholder=(localize "CYPHERSYSTEM.Currency")}}
      {{> ccsText name="system.settings.equipment.currency.labelCategory5" value=s.equipment.currency.labelCategory5 label="5" placeholder=(localize "CYPHERSYSTEM.Currency")}}
      {{> ccsText name="system.settings.equipment.currency.labelCategory6" value=s.equipment.currency.labelCategory6 label="6" placeholder=(localize "CYPHERSYSTEM.Currency")}}
    {{/if}}

    {{> ccsCheck name="system.settings.equipment.cyphers.active" value=s.equipment.cyphers.active label=(localize "CYPHERSYSTEM.Cyphers")}}
    {{> ccsText name="system.settings.equipment.cyphers.label" value=s.equipment.cyphers.label label=(localize "CCS.Settings.Label") placeholder=(localize "CYPHERSYSTEM.Cyphers")}}
    {{#if s.equipment.cyphers.active}}
      {{> ccsCheck name="system.settings.equipment.cyphers.sortByType" value=s.equipment.cyphers.sortByType label=(localize "CYPHERSYSTEM.SortCyphersByType")}}
    {{/if}}
    {{> ccsCheck name="system.settings.equipment.artifacts.active" value=s.equipment.artifacts.active label=(localize "CYPHERSYSTEM.Artifacts")}}
    {{> ccsText name="system.settings.equipment.artifacts.label" value=s.equipment.artifacts.label label=(localize "CCS.Settings.Label") placeholder=(localize "CYPHERSYSTEM.Artifacts")}}
    {{> ccsCheck name="system.settings.equipment.oddities.active" value=s.equipment.oddities.active label=(localize "CYPHERSYSTEM.Oddities")}}
    {{> ccsText name="system.settings.equipment.oddities.label" value=s.equipment.oddities.label label=(localize "CCS.Settings.Label") placeholder=(localize "CYPHERSYSTEM.Oddities")}}
    {{> ccsCheck name="system.settings.equipment.materials.active" value=s.equipment.materials.active label=(localize "CYPHERSYSTEM.CraftingMaterial")}}
    {{> ccsText name="system.settings.equipment.materials.label" value=s.equipment.materials.label label=(localize "CCS.Settings.Label") placeholder=(localize "CYPHERSYSTEM.CraftingMaterial")}}
    {{#if s.equipment.materials.active}}
      {{> ccsSelect name="system.settings.equipment.materials.displayMode" value=s.equipment.materials.displayMode choices=@root.settings.choices.materialsDisplayMode label=(localize "CYPHERSYSTEM.DisplayMode")}}
      {{> ccsCheck name="system.settings.equipment.materials.sortByLevel" value=s.equipment.materials.sortByLevel
          label=(localize (ifThen (eq s.equipment.materials.displayMode "price") "CYPHERSYSTEM.SortMaterialsByPrice" "CYPHERSYSTEM.SortMaterialsByLevel"))}}
    {{/if}}
  </section>
</div>
{{/with}}
